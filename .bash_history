clear && temp_file=$(mktemp) && 
cat << EOF > "$temp_file"
import os
import requests
import urllib.parse
from flask import Flask, render_template_string, request

app = Flask(__name__)

# Folder to save the AI generated images
IMAGE_FOLDER = 'static/ai_images'
if not os.path.exists(IMAGE_FOLDER):
    os.makedirs(IMAGE_FOLDER)

html_template = """
<!DOCTYPE html>
<html>
<head>
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <style>
        body { font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif; background: #121212; color: #e0e0e0; display: flex; justify-content: center; padding: 20px; }
        .app-card { background: #1e1e1e; width: 100%; max-width: 450px; border-radius: 20px; padding: 25px; text-align: center; box-shadow: 0 15px 35px rgba(0,0,0,0.7); border: 1px solid #333; }
        h2 { color: #00e676; letter-spacing: 1px; }
        .result-container { margin: 20px 0; border-radius: 15px; overflow: hidden; background: #2a2a2a; min-height: 200px; display: flex; align-items: center; justify-content: center; border: 1px solid #444; }
        .ai-img { width: 100%; height: auto; display: block; }
        .input-area { background: #2c2c2c; border: 2px solid #444; border-radius: 12px; padding: 15px; width: 90%; color: white; margin-bottom: 15px; font-size: 16px; outline: none; transition: border 0.3s; }
        .input-area:focus { border-color: #00e676; }
        .btn { background: #00e676; color: #000; border: none; padding: 15px 20px; border-radius: 12px; font-weight: bold; width: 100%; cursor: pointer; font-size: 16px; text-transform: uppercase; }
        .loading-text { color: #00e676; font-size: 14px; margin-top: 10px; display: none; }
    </style>
</head>
<body>
    <div class="app-card">
        <h2>GEN-AI CREATOR</h2>
        
        <div class="result-container">
            {% if img_url %}
                <img src="{{ img_url }}" class="ai-img" alt="AI Generated Image">
            {% else %}
                <p style="color: #777;">Your AI creation will appear here</p>
            {% endif %}
        </div>

        <form method="POST" onsubmit="document.getElementById('loader').style.display='block'">
            <textarea name="command" class="input-area" rows="4" placeholder="Type your imagination here... (e.g. 'A realistic leather jacket with gold wings')" required></textarea>
            <button type="submit" class="btn">Generate Image</button>
            <div id="loader" class="loading-text">AI is thinking... please wait...</div>
        </form>

        {% if prompt %}
            <p style="font-size: 12px; color: #888; margin-top: 15px;">Prompt: {{ prompt }}</p>
        {% endif %}
    </div>
</body>
</html>
"""

@app.route('/', methods=['GET', 'POST'])
def index():
    img_url = None
    prompt = None
    
    if request.method == 'POST':
        user_prompt = request.form.get('command')
        if user_prompt:
            # Clean the text for a URL
            encoded_prompt = urllib.parse.quote(user_prompt)
            
            # Use Pollinations.ai - Free, No Key, Real Image Generation
            # We add keywords like 'high quality, 4k' to make it look best
            ai_link = f"https://pollinations.ai/p/{encoded_prompt}?width=1080&height=1080&seed=42&model=flux"
            
            img_url = ai_link
            prompt = user_prompt

    return render_template_string(html_template, img_url=img_url, prompt=prompt)

if __name__ == '__main__':
    # Using host 0.0.0.0 so you can view it on your phone's browser
    app.run(host='0.0.0.0', port=5000, debug=True)
EOF

