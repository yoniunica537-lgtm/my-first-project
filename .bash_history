from flask import Flask, render_template_string, request

app = Flask(__name__)

# Simple HTML template with CSS to make it look like a phone screen
HTML_TEMPLATE = '''
<!DOCTYPE html>
<html>
<head>
    <title>SafaricolabTele</title>
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <style>
        body { font-family: sans-serif; background: #f0f0f0; display: flex; justify-content: center; padding: 20px; }
        .phone { width: 300px; background: white; border: 10px solid #333; border-radius: 20px; padding: 20px; box-shadow: 0 10px 20px rgba(0,0,0,0.2); }
        h2 { color: #2e7d32; text-align: center; }
        .btn { display: block; width: 100%; padding: 10px; margin: 10px 0; background: #e0e0e0; border: none; cursor: pointer; text-align: left; }
        .btn:hover { background: #d0d0d0; }
        .success { color: green; font-weight: bold; text-align: center; }
    </style>
</head>
<body>
    <div class="phone">
        <h2>SafaricolabTele</h2>
        {% if page == 'main' %}
            <a href="/menu/internet"><button class="btn">1. Internet package</button></a>
            <a href="/menu/voice"><button class="btn">2. Voice package</button></a>
            <a href="/"><button class="btn">*. Exit</button></a>
        {% elif page == 'internet' %}
            <p>Select Internet Plan:</p>
            <a href="/purchase/100MB"><button class="btn">1. Daily (100MB - 5 Birr)</button></a>
            <a href="/menu/main"><button class="btn">*. Back</button></a>
        {% elif page == 'voice' %}
            <p>Select Voice Plan:</p>
            <a href="/purchase/200Min"><button class="btn">1. Daily (200 Min - 5 Birr)</button></a>
            <a href="/menu/main"><button class="btn">*. Back</button></a>
        {% elif page == 'success' %}
            <div class="success">
                <p>🎉 Congratulation!</p>
                <p>Successfully purchased {{ item }}</p>
            </div>
            <a href="/menu/main"><button class="btn">** Back to Main Menu</button></a>
        {% endif %}
    </div>
</body>
</html>
'''

@app.route('/')
@app.route('/menu/<page>')
def menu(page='main'):
    return render_template_string(HTML_TEMPLATE, page=page)

@app.route('/purchase/<item>')
def purchase(item):
    return render_template_string(HTML_TEMPLATE, page='success', item=item)

if __name__ == '__main__':
    app.run(debug=True, port=5000)
EOF

